APP_NAME=MailForm
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mailform
DB_USERNAME=mailform
DB_PASSWORD=

LEGACY_DB_DRIVER=mariadb
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
# Set true when serving over HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=warning

MAIL_MAILER=smtp
# Set false on an isolated migration target until delivery is ready.
MAILFORM_DELIVERY_ENABLED=true
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=mailform@example.test
MAIL_FROM_NAME=MailForm

# Optional reCAPTCHA v3; enable separately on each form.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_SCORE=0.5
